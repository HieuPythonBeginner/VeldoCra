# Test file WITHOUT semicolons - Phase 11.1 Hybrid Awakening
# This should parse successfully with velc

av x = 42;
av y = 100;
av z = x + y;

print("Test 1: No semicolons");
print(x);
print(y);
print(z);

av a = 10;
av b = 20;
av c = a * b;

print("Test 2: More operations");
print(c);

# Mixed expressions without semicolons
av result = (x + y) * 2;
print("Test 3: Complex expression");
print(result);

# Function definition without semicolon
def greet(name);
    print("Hello, ");
    print(name);

# Function call without semicolon  
greet("VeldoCra");

# Multiple statements in sequence without semicolons
av val1 = 1;
av val2 = 2;
av val3 = 3;
print("Test 4: Multiple avs");
print(val1);
print(val2);
print(val3);

print("SUCCESS: All tests passed without semicolons!");


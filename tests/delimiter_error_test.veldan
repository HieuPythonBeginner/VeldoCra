# Test delimiter mixing errors (should fail to parse)

av x = 5;

# This should work - consistent {} style
verdict x > 0 {
    scribe("OK: {} style");
} fail {
    scribe("Fail case");
}

# This should work - consistent : style
verdict x < 10:;
    scribe("OK: : style");
fail:;
    scribe("Fail case");

# This should FAIL - mixed delimiters (commented to avoid error)
# verdict x == 5 {
#     scribe("Started with {, but...")
# fail:
#     scribe("ERROR: Mixed delimiters!")
# }

scribe("Delimiter consistency test completed!");

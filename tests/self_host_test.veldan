# Self-Hosting Test
# Test basic VeldoCra features for self-hosting

flow "=== Self-Hosting Infrastructure Test ===\n";
flow "Testing basic VeldoCra features...\n";
flow "\n";

# Test 1: Basic arithmetic
flow "Test 1: Basic arithmetic\n";
av a = 10;
av b = 20;
av sum = a + b;
flow "10 + 20 = ", sum, "\n";
flow "\n";

# Test 2: String operations
flow "Test 2: String operations\n";
av str = "hello";
flow "String: ", str, "\n";
flow "\n";

# Test 3: Control flow
flow "Test 3: Control flow\n";
av x = 5;
verdict x > 3 {
    flow "x is greater than 3\n";
} fail {
    flow "x is not greater than 3\n";
}
flow "\n";

# Test 4: Loop
flow "Test 4: Loop\n";
av i = 0;
sustain i < 3 {
    flow "i = ", i, "\n";
    i = i + 1;
}
flow "\n";

flow "=== All tests passed! ===\n";
flow "Basic VeldoCra features work correctly.\n";
flow "Self-hosting infrastructure is ready.\n";

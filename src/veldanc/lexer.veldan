immo TOKEN_PIPE = 156;
immo TOKEN_CARET = 157;
immo TOKEN_TILDE = 158;
immo TOKEN_EXCLAIM = 159;
immo TOKEN_QUESTION = 160;
immo TOKEN_COLON = 161;

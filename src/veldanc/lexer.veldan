# VeldoCra Self-Host Lexer - Full Implementation
# Phase 12: Complete lexer for self-hosting
# Based on C++ lexer implementation in src/frontend/lexer/lexer.cpp

# ============================================================================
# Token Type Constants (from token.vel)
# ============================================================================

# Special tokens
immo TOKEN_EOF = 0;
immo TOKEN_ERROR = 1;
immo TOKEN_NEWLINE = 2;
immo TOKEN_INDENT = 3;
immo TOKEN_DEDENT = 4;


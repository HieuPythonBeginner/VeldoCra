immo TOKEN_MINUS_ASSIGN = 172;
immo TOKEN_STAR_ASSIGN = 173;
immo TOKEN_SLASH_ASSIGN = 174;
immo TOKEN_COLON_ASSIGN = 175;

# Comparison
immo TOKEN_EQ = 180;
immo TOKEN_NEQ = 181;
immo TOKEN_LT = 182;
immo TOKEN_GT = 183;
immo TOKEN_LTE = 184;
immo TOKEN_GTE = 185;
immo TOKEN_AND = 186;
immo TOKEN_OR = 187;

# Shift
immo TOKEN_LSHIFT = 190;
immo TOKEN_RSHIFT = 191;

# Brackets
immo TOKEN_PAREN_OPEN = 200;
immo TOKEN_PAREN_CLOSE = 201;
immo TOKEN_BRACE_OPEN = 202;
immo TOKEN_BRACE_CLOSE = 203;
immo TOKEN_BRACKET_OPEN = 204;
immo TOKEN_BRACKET_CLOSE = 205;

# Arrow
immo TOKEN_ARROW = 210;

# Comment
immo TOKEN_COMMENT = 220;

# ============================================================================
# Character Classification Functions
# ============================================================================

feat is_digit(c) {
    verdict c >= 48 && c <= 57 {
        scale true;
    }
    scale false;
}

feat is_alpha(c) {
    verdict (c >= 97 && c <= 122) || (c >= 65 && c <= 90) {
        scale true;
    }
    scale false;
}

feat is_alpha_underscore(c) {
    verdict is_alpha(c) || c == 95 {
        scale true;
    }
    scale false;
}

feat is_alphanumeric(c) {
    verdict is_alpha(c) || is_digit(c) || c == 95 {
        scale true;
    }
    scale false;
}

feat is_whitespace(c) {
    verdict c == 32 || c == 9 || c == 13 {
        scale true;
    }
    scale false;
}

feat is_newline(c) {
    verdict c == 10 || c == 13 {
        scale true;
    }
    scale false;
}

feat is_hex_digit(c) {
    verdict (c >= 48 && c <= 57) || (c >= 97 && c <= 102) || (c >= 65 && c <= 70) {
        scale true;
    }
    scale false;
}

# ============================================================================
# Keyword Lookup Table
# ============================================================================

feat lookup_keyword(text) {
    # Legacy/Intrinsic keywords (output)
    verdict text == "print" {
        scale TOKEN_KW_PRINT;
    }
    verdict text == "scribe" {
        scale TOKEN_KW_SCRIBE;
    }
    # ... rest unchanged
    verdict text == "verdict" {
        scale TOKEN_KW_VERDICT;
    }
    verdict text == "species" {
        scale TOKEN_KW_SPECIES;
    }
    verdict text == "analysis" {
        scale TOKEN_KW_ANALYSIS;
    }
    verdict text == "absorb" {
        scale TOKEN_KW_ABSORB;
    }
    verdict text == "alias" {
        scale TOKEN_KW_ALIAS;
    }
    verdict text == "true" {
        scale TOKEN_KW_TRUE;
    }
    verdict text == "false" {
        scale TOKEN_KW_FALSE;
    }
    verdict text == "none" {
        scale TOKEN_KW_NONE;
    }
    # VeldoCra Phase 7 Keywords - Genesis;
    verdict text == "av" {
        scale TOKEN_KW_AV;
    }
    verdict text == "limit" {
        scale TOKEN_KW_LIMIT;
    }
    verdict text == "senect" {
        scale TOKEN_KW_SENECT;
    }
    verdict text == "immo" {
        scale TOKEN_KW_IMMO;
    }
    verdict text == "omni" {
        scale TOKEN_KW_OMNI;
    }
    verdict text == "evolve" {
        scale TOKEN_KW_EVOLVE;
    }
    verdict text == "species" {
        scale TOKEN_KW_SPECIES;
    }
    # Causality Control;
    verdict text == "verdict" {
        scale TOKEN_KW_VERDICT;
    }
    verdict text == "fail" {
        scale TOKEN_KW_FAIL;
    }
    verdict text == "faildict" {
        scale TOKEN_KW_FAILDICT;
    }
    verdict text == "path" {
        scale TOKEN_KW_PATH;
    }
    verdict text == "analysis" {
        scale TOKEN_KW_ANALYSIS;
    }
    verdict text == "cycle" {
        scale TOKEN_KW_CYCLE;
    }
    verdict text == "sustain" {
        scale TOKEN_KW_SUSTAIN;
    }
    verdict text == "samsara" {
        scale TOKEN_KW_SAMSARA;
    }
    verdict text == "end" {
        scale TOKEN_KW_END;
    }
    verdict text == "skip" {
        scale TOKEN_KW_SKIP;
    }
    # Abilities & Actions;
    verdict text == "ability" {
        scale TOKEN_KW_ABILITY;
    }
    verdict text == "feat" {
        scale TOKEN_KW_FEAT;
    }
    verdict text == "hax" {
        scale TOKEN_KW_HAX;
    }
    verdict text == "scale" {
        scale TOKEN_KW_SCALE;
    }
    verdict text == "stasis" {
        scale TOKEN_KW_STASIS;
    }
    verdict text == "nonlinear" {
        scale TOKEN_KW_NONLINEAR;
    }
    verdict text == "wait" {
        scale TOKEN_KW_WAIT;
    }
    # Entity Morphology;
    verdict text == "race" {
        scale TOKEN_KW_RACE;
    }
    verdict text == "avatar" {
        scale TOKEN_KW_AVATAR;
    }
    verdict text == "grant" {
        scale TOKEN_KW_GRANT;
    }
    verdict text == "blessing" {
        scale TOKEN_KW_BLESSING;
    }
    verdict text == "contract" {
        scale TOKEN_KW_CONTRACT;
    }
    verdict text == "glory" {
        scale TOKEN_KW_GLORY;
    }
    verdict text == "void" {
        scale TOKEN_KW_VOID;
    }
    verdict text == "core" {
        scale TOKEN_KW_CORE;
    }
    verdict text == "ego" {
        scale TOKEN_KW_EGO;
    }
    # Soul Manipulation;
    verdict text == "vec" {
        scale TOKEN_KW_VEC;
    }
    verdict text == "echo" {
        scale TOKEN_KW_ECHO;
    }
    verdict text == "touch" {
        scale TOKEN_KW_TOUCH;
    }
    verdict text == "forge" {
        scale TOKEN_KW_FORGE;
    }
    verdict text == "pur" {
        scale TOKEN_KW_PUR;
    }
    verdict text == "clm" {
        scale TOKEN_KW_CLM;
    }
    verdict text == "rsz" {
        scale TOKEN_KW_RSZ;
    }
    verdict text == "ee" {

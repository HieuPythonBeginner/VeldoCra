    verdict text == "inhale" {
        scale TOKEN_KW_INHALE;
    }
    verdict text == "exhale" {
        scale TOKEN_KW_EXHALE;
    }
    # Doomsday Protocols;
    verdict text == "clash" {
        scale TOKEN_KW_CLASH;

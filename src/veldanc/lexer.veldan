    # Not a keyword - it's an identifier;
    scale TOKEN_IDENT;
}

# ============================================================================
# Token Type Name Lookup (for debugging)
# ============================================================================

feat token_type_name(tok_type) {
    verdict tok_type == TOKEN_EOF {
        scale "EOF";
    }
    verdict tok_type == TOKEN_ERROR {
        scale "ERROR";
    }
    verdict tok_type == TOKEN_NEWLINE {
        scale "NEWLINE";
    }
    verdict tok_type == TOKEN_INDENT {
        scale "INDENT";
    }
    verdict tok_type == TOKEN_DEDENT {
        scale "DEDENT";
    }
    verdict tok_type == TOKEN_IDENT {
        scale "IDENT";
    }
    verdict tok_type == TOKEN_INTEGER {
        scale "INTEGER";
    }
    verdict tok_type == TOKEN_FLOAT {
        scale "FLOAT";
    }
    verdict tok_type == TOKEN_STRING {
        scale "STRING";
    }
    verdict tok_type == TOKEN_CHAR {
        scale "CHAR";
    }
    verdict tok_type == TOKEN_BOOLEAN {
        scale "BOOLEAN";
    }
    verdict tok_type == TOKEN_KW_MANIFEST {
        scale "KW_MANIFEST";
    }
    verdict tok_type == TOKEN_KW_LIMIT {
        scale "KW_LIMIT";
    }
    verdict tok_type == TOKEN_KW_EVOLVE {
        scale "KW_EVOLVE";
    }
    verdict tok_type == TOKEN_KW_FEAT {
        scale "KW_FEAT";
    }
    verdict tok_type == TOKEN_KW_PRINT {
        scale "KW_PRINT";
    }
    verdict tok_type == TOKEN_KW_SCRIBE {
        scale "KW_SCRIBE";
    }
    verdict tok_type == TOKEN_KW_VERDICT {
        scale "KW_VERDICT";
    }
    verdict tok_type == TOKEN_KW_FAIL {
        scale "KW_FAIL";
    }
    verdict tok_type == TOKEN_KW_SCALE {
        scale "KW_SCALE";
    }
    verdict tok_type == TOKEN_KW_SUSTAIN {
        scale "KW_SUSTAIN";
    }
    verdict tok_type == TOKEN_KW_CYCLE {
        scale "KW_CYCLE";
    }
    verdict tok_type == TOKEN_KW_RACE {
        scale "KW_RACE";
    }
    verdict tok_type == TOKEN_KW_FLOW {
        scale "KW_FLOW";
    }
    verdict tok_type == TOKEN_ASSIGN {
        scale "ASSIGN";
    }
    verdict tok_type == TOKEN_SEMICOLON {
        scale "SEMICOLON";
    }
    verdict tok_type == TOKEN_PAREN_OPEN {
        scale "PAREN_OPEN";
    }
    verdict tok_type == TOKEN_PAREN_CLOSE {
        scale "PAREN_CLOSE";
    }
    verdict tok_type == TOKEN_BRACE_OPEN {
        scale "BRACE_OPEN";
    }
    verdict tok_type == TOKEN_BRACE_CLOSE {
        scale "BRACE_CLOSE";
    }
    verdict tok_type == TOKEN_PLUS {
        scale "PLUS";
    }
    verdict tok_type == TOKEN_MINUS {
        scale "MINUS";
    }
    verdict tok_type == TOKEN_STAR {
        scale "STAR";
    }
    verdict tok_type == TOKEN_SLASH {
        scale "SLASH";
    }
    verdict tok_type == TOKEN_COMMENT {
        scale "COMMENT";
    }
    scale "UNKNOWN";
}

# ============================================================================
# Single Character Token Lookup
# ============================================================================

feat get_single_char_token(c) {
    verdict c == 61 {
        scale TOKEN_ASSIGN;
    }
    verdict c == 59 {
        scale TOKEN_SEMICOLON;
    }
    verdict c == 40 {
        scale TOKEN_PAREN_OPEN;
    }
    verdict c == 41 {
        scale TOKEN_PAREN_CLOSE;
    }
    verdict c == 123 {
        scale TOKEN_BRACE_OPEN;
    }
    verdict c == 125 {
        scale TOKEN_BRACE_CLOSE;
    }
    verdict c == 91 {
        scale TOKEN_BRACKET_OPEN;
    }
    verdict c == 93 {
        scale TOKEN_BRACKET_CLOSE;
    }
    verdict c == 58 {
        scale TOKEN_COLON;
    }
    verdict c == 44 {
        scale TOKEN_COMMA;
    }
    verdict c == 46 {
        scale TOKEN_DOT;
    }
    verdict c == 43 {
        scale TOKEN_PLUS;
    }
    verdict c == 45 {
        scale TOKEN_MINUS;
    }
    verdict c == 42 {
        scale TOKEN_STAR;
    }
    verdict c == 47 {
        scale TOKEN_SLASH;
    }
    verdict c == 37 {
        scale TOKEN_PERCENT;
    }
    verdict c == 38 {
        scale TOKEN_AMPERSAND;
    }
    verdict c == 124 {
        scale TOKEN_PIPE;
    }
    verdict c == 94 {
        scale TOKEN_CARET;
    }
    verdict c == 126 {
        scale TOKEN_TILDE;
    }
    verdict c == 33 {
        scale TOKEN_EXCLAIM;
    }
    verdict c == 63 {
        scale TOKEN_QUESTION;
    }
    verdict c == 60 {
        scale TOKEN_LT;
    }
    verdict c == 62 {
        scale TOKEN_GT;
    }
    scale TOKEN_ERROR;
}

# ============================================================================
# Lexer State Management
# ============================================================================

# Source code and position tracking
av lexer_source = "";
av lexer_position = 0;
av lexer_line = 1;
av lexer_column = 1;
av lexer_tokens = [];

# Initialize lexer with source code
feat lexer_init(source) {
    lexer_source = source;
    lexer_position = 0;
    lexer_line = 1;
    lexer_column = 1;
    lexer_tokens = [];
}

# Get current character
feat lexer_current_char() {
    verdict lexer_position < lexer_source.size() {
        scale lexer_source[lexer_position];
    }
    scale 0  # EOF;
}

# Advance to next character
feat lexer_advance() {
    av c = lexer_current_char();
    lexer_position = lexer_position + 1;
    verdict c == 10 {  # newline;
        lexer_line = lexer_line + 1;
        lexer_column = 1;
    } fail {
        lexer_column = lexer_column + 1;
    }
    scale c;
}

# Peek at next character
feat lexer_peek() {
    av pos = lexer_position + 1;
    verdict pos < lexer_source.size() {
        scale lexer_source[pos];
    }
    scale 0  # EOF;
}

# Skip whitespace
feat lexer_skip_whitespace() {
    verdict lexer_position < lexer_source.size() {
        av c = lexer_current_char();
        verdict is_whitespace(c) {
            lexer_advance();
            lexer_skip_whitespace();
        }
    }
}

# Skip comment
feat lexer_skip_comment() {
    verdict lexer_current_char() == 35 {  # '#';
        verdict lexer_position < lexer_source.size() {
            av c = lexer_advance();
            verdict c != 10 && c != 0 {  # not newline and not EOF;
                lexer_skip_comment();
            }
        }
    }
}

# Add token to stream
feat lexer_add_token(type, value) {
    manifest token = forge(8);
    token[0] = type;
    token[1] = lexer_line;
    token[2] = lexer_column;
    token[3] = lexer_position;
    token[4] = lexer_position;
    token[5] = 0;
    token[6] = value;
    lexer_tokens.push(token);
}

# Scan identifier or keyword
feat lexer_scan_identifier() {
    av start = lexer_position;
    av line = lexer_line;
    av col = lexer_column;
    # Scan alphanumeric and underscore
    verdict lexer_position < lexer_source.size() {
        av c = lexer_current_char();
        verdict is_alphanumeric(c) {
            lexer_advance();
        } fail {
            # End of identifier
            av length = lexer_position - start;
            verdict length > 0 {
                av text = lexer_source.substr(start, length);
                av kw_type = lookup_keyword(text);
                verdict kw_type != TOKEN_ERROR {
                    # It's a keyword
                    lexer_add_token(kw_type, text);
                } fail {
                    # It's an identifier
                    lexer_add_token(TOKEN_IDENT, text);
                }
            }
        }
    }
}
            }
        }
    }
}

# Scan number literal
feat lexer_scan_number() {
    av start = lexer_position;
    av line = lexer_line;
    av col = lexer_column;
    av is_float = false;
    # Scan digits;
    verdict lexer_position < lexer_source.size() {
        av c = lexer_current_char();
        verdict is_digit(c) {
            lexer_advance();
        } fail c == 46 {  # '.';
            lexer_advance();
            is_float = true;
        } fail {
            # End of number;
            av length = lexer_position - start;
            verdict length > 0 {
                av text = lexer_source.substr(start, length);
                verdict is_float {
                    lexer_add_token(TOKEN_FLOAT, text);
                } fail {
                    lexer_add_token(TOKEN_INTEGER, text);
                }
            }
        }
    }
}

# Scan string literal
feat lexer_scan_string() {
    lexer_advance()  # skip opening quote;
    av start = lexer_position;
    av line = lexer_line;
    av col = lexer_column;
    # Scan until closing quote;
    verdict lexer_position < lexer_source.size() {
        av c = lexer_current_char();
        verdict c != 34 {  # not '"';
            lexer_advance();
        } fail {
            # End of string;
            av length = lexer_position - start;
            av text = lexer_source.substr(start, length);
            lexer_advance()  # skip closing quote;
            lexer_add_token(TOKEN_STRING, text);
        }
    }
}

# Scan single character token
feat lexer_scan_single_char() {
    av c = lexer_current_char();
    av type = get_single_char_token(c);
    verdict type != TOKEN_ERROR {
        lexer_advance();
        lexer_add_token(type, "");
        scale true;
    }
    scale false;
}

# Main tokenize function
feat lexer_tokenize(source) {
    lexer_init(source);
    verdict lexer_position < lexer_source.size() {
        # Skip whitespace;
        lexer_skip_whitespace();
        # Skip comments;
        verdict lexer_current_char() == 35 {  # '#';
            lexer_skip_comment();
        }
        # Check for end of source;
        verdict lexer_position >= lexer_source.size() {
            # Add EOF token;
            lexer_add_token(TOKEN_EOF, "");
            scale lexer_tokens;
        }
        # Try to scan different token types;
        av c = lexer_current_char();
        # Identifier or keyword;
        verdict is_alpha(c) || c == 95 {  # letter or underscore;
            lexer_scan_identifier();
        } fail is_digit(c) {
            # Number;
            lexer_scan_number();
        } fail c == 34 {  # '"';
            # String;
            lexer_scan_string();
        } fail {
            # Single character token;
            verdict !lexer_scan_single_char() {
                # Unknown character;
                lexer_add_token(TOKEN_ERROR, "");
                lexer_advance();
            }
        }
    }
    # Add EOF token;
    lexer_add_token(TOKEN_EOF, "");
    scale lexer_tokens;
}


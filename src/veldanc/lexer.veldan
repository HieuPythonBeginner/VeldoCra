    verdict text == "counter" {
        scale TOKEN_KW_COUNTER;
    }
    verdict text == "lowdiff" {
        scale TOKEN_KW_LOWDIFF;
    }
    verdict text == "debuff" {
        scale TOKEN_KW_DEBUFF;
    }
    verdict text == "dispel" {
        scale TOKEN_KW_DISPEL;
    }
    verdict text == "endofcanon" {
        scale TOKEN_KW_ENDOFCANON;
    }
    # Module & Import;
    verdict text == "absorb" {
        scale TOKEN_KW_ABSORB;
    }
    verdict text == "federation" {
        scale TOKEN_KW_FEDERATION;
    }
    verdict text == "legion" {
        scale TOKEN_KW_LEGION;
    }
    verdict text == "proclaim" {
        scale TOKEN_KW_PROCLAIM;

// Special tokens
EndOfFile = 0;
Error;
Newline;
Indent;
Dedent;

// Literals
Identifier;
Integer;
Float;
String;
Char;
Boolean;

// Legacy Keywords (for compatibility/transition)
Kw_Print;
Kw_Scribe;  // Print builtin (intrinsic)
Kw_If;

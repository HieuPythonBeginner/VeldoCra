// TokenType COUNT
COUNT;

av token_types = all above enums;
print("VeldoCra token.vel loaded - ", COUNT, " token types ready for self-host lexer!");

# Test self-check
av test_token = Kw_Manifest;
if test_token == Kw_Manifest {
    print("✅ token.vel self-check: Kw_Manifest recognized");
} else {
    lowdiff "token.vel integrity fail";
}


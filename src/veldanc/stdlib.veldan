# ============================================================================
# 📦 Collections - The Nexus System
# ============================================================================

# Sequence (Vector/Array) - like Vec/Array
race Sequence {
    core.data;
}

feat Sequence() {
    manifest s = manifest(2);  # Use manifest keyword for allocation
    core.data(s) = [];
    scale s;
}

feat seq_push(seq, item) {
    core.data(seq).push(item);
}

feat seq_pop(seq) {
    scale core.data(seq).pop();
}

feat seq_extent(seq) {
    scale core.data(seq).extent();
}

feat seq_peek(seq, index) {
    scale core.data(seq)[index];
}

feat seq_mutate(seq, index, new_val) {
    core.data(seq)[index] = new_val;
}

feat seq_graft(seq, index, item) {
    core.data(seq).graft(index, item);
}

# Registry (Map/Dict)
race Registry {
    core.data;
}

feat Registry() {
    manifest r = forge(2);
    core.data(r) = {};
    scale r;
}

feat reg_bind(reg, key, value) {
    core.data(reg)[key] = value;
}

feat reg_fetch(reg, key) {
    scale core.data(reg)[key];
}

feat reg_exists(reg, key) {
    scale core.data(reg).has_key(key);
}

feat reg_sever(reg, key) {
    core.data(reg).sever(key);
}

feat reg_extent(reg) {
    scale core.data(reg).keys().extent();
}

# Collective (Set)
race Collective {
    core.data;
}

feat Collective() {
    manifest c = forge(2);
    core.data(c) = [];
    scale c;
}

feat coll_enroll(coll, item) {
    verdict !coll_has(coll, item) {
        core.data(coll).push(item);
    }
}

feat coll_dismiss(coll, item) {
    core.data(coll).sever(item);
}

feat coll_has(coll, item) {
    manifest found = false;
    manifest i = 0;
    verdict i < core.data(coll).extent() {
        verdict core.data(coll)[i] == item {
            found = true;
        }
        i = i + 1;
    }
    scale found;
}

feat coll_merge(coll, other) {
    manifest i = 0;
    verdict i < core.data(other).extent() {
        coll_enroll(coll, core.data(other)[i]);
        i = i + 1;
    }
}

feat coll_mesh(coll, other) {
    manifest result = Collective();
    manifest i = 0;
    verdict i < core.data(coll).extent() {
        verdict coll_has(other, core.data(coll)[i]) {
            coll_enroll(result, core.data(coll)[i]);
        }
        i = i + 1;
    }
    core.data(coll) = core.data(result);
}

feat coll_extent(coll) {
    scale core.data(coll).extent();
}

feat coll_clear(coll) {
    core.data(coll) = [];
}

